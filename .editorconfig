root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{kt,kts}]
# Android's own style (Kotlin coding conventions + Android Kotlin style guide), not ktlint's
# stricter default `ktlint_official`.
ktlint_code_style = android_studio
# Compose functions are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Test names in backticks are sentences; let them run past the line limit.
ktlint_ignore_back_ticked_identifier = true
